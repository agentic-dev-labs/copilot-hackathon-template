{
  "name": "Copilot Hackathon",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "onCreateCommand": {
    "uv": "bash -o pipefail -c 'curl -LsSf https://astral.sh/uv/0.9.7/install.sh | sh'",
    "copilot-cli": "bash -o pipefail -c 'curl -fsSL https://gh.io/copilot-install | bash'"
  },
  "updateContentCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": {
    "welcome": "printf '\\nStart with: python -m pytest\\nThen open labs/00-setup/README.md\\n'"
  },
  "waitFor": "updateContentCommand",
  "remoteEnv": {
    "UV_NATIVE_TLS": "true",
    "VIRTUAL_ENV": "${containerWorkspaceFolder}/.venv",
    "PATH": "${containerWorkspaceFolder}/.venv/bin:/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Vendor review app",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        "GitHub.vscode-github-actions",
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-azurecontainerapps",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "github.copilot.chat.organizationCustomAgents.enabled": true,
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit"
          }
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "//": [
    "Tools run in the container; Python dependencies use the checked-in uv.lock file.",
    "Browser demos use Copilot's built-in browser tools; no separate browser MCP server is installed.",
    "Host requirements are minimums, not a fixed machine size. Extension IDs do not pin versions.",
    "Copilot authentication and organization-agent access still depend on the signed-in account.",
    "Setup completes before normal attachment. Day 2 service configuration is optional."
  ]
}
