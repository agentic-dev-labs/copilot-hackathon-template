{
  "name": "Copilot Hackathon",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "onCreateCommand": {
    "uv": "bash -o pipefail -c 'curl -LsSf https://astral.sh/uv/0.9.7/install.sh | sh'",
    "copilot-cli": "bash -o pipefail .devcontainer/setup.sh cli"
  },
  "updateContentCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": {
    "website-preview": "bash .devcontainer/setup.sh preview",
    "welcome": "printf '\\nWelcome! Follow the presenter. Your guide is docs/START-HERE.md.\\n'"
  },
  "waitFor": "updateContentCommand",
  "remoteEnv": {
    "UV_NATIVE_TLS": "true",
    "VIRTUAL_ENV": "${containerWorkspaceFolder}/.venv",
    "PATH": "${containerWorkspaceFolder}/.venv/bin:/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Private preview server (presenter and deployment checks)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        "GitHub.vscode-github-actions",
        "ms-python.python",
        "ms-python.vscode-python-envs",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "github.copilot.chat.organizationCustomAgents.enabled": false,
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit"
          }
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}