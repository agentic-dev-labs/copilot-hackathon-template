{
  "name": "Copilot Hackathon",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "onCreateCommand": {
    "uv": "curl -LsSf https://astral.sh/uv/install.sh | sh",
    "copilot-cli": "curl -fsSL https://gh.io/copilot-install | bash || echo 'Copilot CLI install failed; see docs/FACILITATOR.md'"
  },
  "postCreateCommand": "$HOME/.local/bin/uv sync --extra dev --extra web",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Vendor review app",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-github-actions",
        "ms-python.python",
        "ms-azuretools.vscode-azurecontainerapps",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "github.copilot.chat.organizationCustomAgents.enabled": true,
        "python.testing.pytestEnabled": true
      }
    }
  },
  "//": "Node.js and the Copilot CLI live in the container so attendee laptops need no local install. The organizationCustomAgents setting is what makes the shared vendor-analyst agent appear."
}
